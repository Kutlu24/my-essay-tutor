# Grading LLM (grammar + CEFR scoring)
GRADING_PROVIDER=glm
GLM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Handwriting/print text extraction (vision LLM -- see ocr.py)
# glm-4.5v needs a paid GLM resource package even when GLM_API_KEY works fine
# for text grading; gemini is the free-tier-friendly default.
OCR_PROVIDER=gemini
OCR_MODEL=glm-4.5v

MAX_UPLOAD_MB=10

# Independent, non-LLM grammar cross-check (grammar_check.py) - off by
# default. Uses language_tool_python's hosted Public API by default, never
# a local server - see README for why. Expect occasional rate limits on
# the free public tier.
ENABLE_GRAMMAR_CROSSCHECK=false
# Only takes effect if ENABLE_GRAMMAR_CROSSCHECK=true. Switches to
# language_tool_python's local-server mode (a resident local Java
# process) instead of the Public API - do NOT enable this on Render's
# free tier or anywhere without real memory headroom above LanguageTool's
# own JVM footprint. Kept off, for a future deploy target with room to
# actually run it.
GRAMMAR_CROSSCHECK_LOCAL_SERVER=false
