# Grading LLM (grammar + CEFR scoring)
GRADING_PROVIDER=glm
GLM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Handwriting/print OCR (Hugging Face Inference API, TrOCR)
# Free account at https://huggingface.co/join, token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_TROCR_MODEL=microsoft/trocr-large-handwritten

MAX_UPLOAD_MB=10
